# ==============================================================================
# 1. TWITCH CONFIGURATION
# ==============================================================================
TWITCH_OAUTH=oauth:xxxxxxxxxxxx
BOT_USERNAME=TwitchAccountName
# Comma-separated channel names (NO #)
CHANNELS=Channel1,example2,etc

# ==============================================================================
# 2. OPENROUTER & AI SETTINGS
# ==============================================================================
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEFAULT_MODEL=google/gemma-4-31b-it

# Replies work like this: "*prefix* *suffix* *user message*". 
# The suffix is the general rule for all prefixes/personalities. 
DEFAULT_SUFFIX=< Roleplay as this, be as lore accurate as possible whilst keeping to the character. Mix up your replies and be original. Reply naturally in character, dont detail your prefix in your replies. Use plenty of Twitch emojis and reply within 200 characters.

# ==============================================================================
# 3. BOT BEHAVIOR & LIMITS
# ==============================================================================
COOLDOWN_SECONDS=10
MAX_INPUT_CHARS=600
MAX_OUTPUT_CHARS=400
SPLIT_AFTER_CHARS=200
MAX_SPLIT_MESSAGES=2

# History: Messages to keep before clearing the oldest per persona
# Shorten this if the bot gets confused on cheaper models or to save tokens
HISTORY_TURNS=6
STATE_FILE=channel_state.json

# AI API Limits
AI_TEMPERATURE=2
AI_MAX_TOKENS=1500

# ==============================================================================
# 4. DEFAULT TRIGGERS & COMMANDS
# ==============================================================================
TRIGGER_COMMANDS=!bot,bot,botnamehere,!chat,chat,ai,!ai
# Optional; if omitted, defaults to @BOT_USERNAME and DEFAULT_CHANNEL_COMMAND
TRIGGER_MENTIONS=@yourbotname
# Default command if a channel hasn't set one yet
DEFAULT_CHANNEL_COMMAND=!bot

# ==============================================================================
# 5. CUSTOM MESSAGES
# ==============================================================================
HELP_MESSAGE=Need help using the bot? Check out the guide here: www.github.com/Meredith2k5/Twitch-Openrouter-Bot
# Used if OpenRouter times out or fails to reply
FALLBACK_MESSAGE=…I’ve got nothing. Which is impressive, even for me Kappa Try again in a minute 
# Catch-all for invalid models or internal bot errors
ERROR_MESSAGE=Had a bit of a wobble innit WutFace Try again in a minute

# ==============================================================================
# 6. PERMISSIONS & LOGGING
# ==============================================================================
# 1 = Mods + broadcaster can use !model/!models/!reload | 0 = Broadcaster only
ALLOW_MOD_COMMANDS=1

# 1 = ON | 0 = OFF
DEBUG=1
LOG_REPLY=1
LOG_REPLY_MAX_CHARS=600

# ==============================================================================
# 7. ALIASES (Comma-separated, NO !)
# ==============================================================================
ALIAS_PREFIX=personality,persona 
ALIAS_SUFFIX=append,rule
ALIAS_SET=setpersona,changepersona
ALIAS_MODEL=switchmodel
ALIAS_CFG=config,setup
ALIAS_RESET=clear,wipe
ALIAS_COMMANDTRIGGER=triggers
ALIAS_CLEARPERSONALITY=delpersona,removepersona,delpersonality,rmpersonality
ALIAS_LISTPERSONALITY=listpersona,personas,personalities
ALIAS_BOTHELP=help,info
ALIAS_MUTEBOT=mute,silence
ALIAS_UNMUTEBOT=unmute,speak
